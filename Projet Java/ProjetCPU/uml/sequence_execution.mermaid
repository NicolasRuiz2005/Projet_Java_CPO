sequenceDiagram
    title Diagramme de séquence — Exécution d'un programme

    actor Utilisateur
    participant Main
    participant Assembler
    participant Memory
    participant CPU
    participant ProgramCounter
    participant RegisterFile
    participant ALU

    Utilisateur->>Main: main()
    Main->>CPU: new CPU()
    CPU->>Memory: new Memory()
    CPU->>RegisterFile: new RegisterFile()
    CPU->>ProgramCounter: new ProgramCounter()

    Main->>Assembler: new Assembler(memory)
    Main->>Assembler: assemble(source)
    Note over Assembler: Passe 1 : collecte des labels
    Assembler->>Memory: write(addr, opcode)
    Assembler->>Memory: write(addr, param...)
    Note over Assembler: Passe 2 : émission du code machine

    Main->>CPU: run()
    loop Tant que running == true
        CPU->>Memory: read(pc.get())   [FETCH opcode]
        Memory-->>CPU: opcode
        CPU->>ProgramCounter: increment()

        alt opcode == LOAD_CONST
            CPU->>Memory: read(pc)     [FETCH reg]
            CPU->>Memory: read(pc)     [FETCH val]
            CPU->>RegisterFile: set(reg, val)
        else opcode == ADD
            CPU->>Memory: read(pc)     [FETCH dest]
            CPU->>Memory: read(pc)     [FETCH a]
            CPU->>Memory: read(pc)     [FETCH b]
            CPU->>RegisterFile: get(a)
            CPU->>RegisterFile: get(b)
            CPU->>ALU: add(va, vb)
            ALU-->>CPU: result
            CPU->>RegisterFile: set(dest, result)
        else opcode == JUMP
            CPU->>Memory: read(pc)     [FETCH addrHigh]
            CPU->>Memory: read(pc)     [FETCH addrLow]
            CPU->>ProgramCounter: set(address)
        else opcode == BREAK
            CPU->>CPU: running = false
        end
    end

    CPU-->>Main: (terminé)
    Main->>RegisterFile: get(0..15)
    Main-->>Utilisateur: Affichage des résultats
